<resources>
    <style name="Theme.MyReaderApp.Voice" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="windowNoTitle">true</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="colorPrimary">@color/reader_primary</item>
        <item name="colorSecondary">@color/reader_primary</item>
        <item name="android:windowBackground">@color/reader_surface</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Theme.MyReaderApp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/reader_primary</item>
        <item name="colorSecondary">@color/reader_primary</item>
        <item name="android:windowBackground">@color/reader_background</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:statusBarColor">@color/reader_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/reader_ink</item>
        <item name="android:textColorPrimary">@color/reader_ink</item>
        <item name="android:textColorSecondary">@color/reader_secondary</item>
    </style>
    <style name="ReaderSecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">8dp</item>
        <item name="strokeColor">@color/reader_line</item>
    </style>
    <style name="ReaderLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/reader_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="ReaderInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/input_background</item>
        <item name="android:padding">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/reader_ink</item>
    </style>
</resources>
